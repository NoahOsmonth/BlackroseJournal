PORT=8787
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081
AGENT_API_KEY=

# Supabase JWT verification and server-only control-plane access.
# Local CLI defaults are shown; production URLs must use HTTPS.
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_CONTROL_REST_URL=http://127.0.0.1:54321/rest/v1
SUPABASE_SECRET_KEY=YOUR_LOCAL_OR_HOSTED_SERVER_SECRET

# AES-256-GCM envelope encryption for managed provider credentials.
# Generate a 32-byte key with: openssl rand -base64 32
# The JSON ring must include the current version/key and any prior key still
# referenced by provider_credentials. Keep all values in a secret manager.
AI_CREDENTIAL_MASTER_KEY_VERSION=1
AI_CREDENTIAL_MASTER_KEY_BASE64=YOUR_32_BYTE_BASE64_KEY
AI_CREDENTIAL_MASTER_KEY_RING_JSON={"1":"YOUR_32_BYTE_BASE64_KEY"}

# Authenticated gateway memory (server-only; never expose as EXPO_PUBLIC_*).
# Generate the bank key once with: openssl rand -base64 32
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=
HINDSIGHT_MEMORY_BANK_HMAC_KEY_BASE64=
HINDSIGHT_MEMORY_BANK_KEY_VERSION=1

# Provider config (PR1 new names — preferred). PR5 will plumb NANO_GPT_* into
# these as a backward-compat shim. Until then, set them explicitly:
# AI_DEFAULT_API_KEY=
# AI_DEFAULT_API_BASE_URL=https://nano-gpt.com/api/v1
# AI_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# AI_DEFAULT_FLASH_MODEL=nvidia/nemotron-3-ultra-550b-a55b

NANO_GPT_API_KEY=
NANO_GPT_API_BASE_URL=https://nano-gpt.com/api/v1
NANO_GPT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NANO_GPT_FLASH_MODEL=nvidia/nemotron-3-ultra-550b-a55b
