PORT=8787
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081
AGENT_API_KEY=

# Memory mirror deployment fence. MEMORY_WRITER_EPOCH is required: a stale
# deployment without an epoch must never query the database for a newer one.
# MEMORY_MIRROR_WRITES_ENABLED is the kill switch (default on when unset;
# set 0/false to pause mirror writes — reads stay healthy).
MEMORY_DEPLOYMENT_ID=blackrose-primary
MEMORY_WRITER_EPOCH=7
MEMORY_WRITER_LEASE_ID=
MEMORY_WRITER_LEASE_TOKEN=
MEMORY_SOURCE_CREDENTIAL_FINGERPRINT=
MEMORY_MIRROR_WRITES_ENABLED=1

# Provider config (PR1 new names — preferred). PR5 will plumb NANO_GPT_* into
# these as a backward-compat shim. Until then, set them explicitly:
# AI_DEFAULT_API_KEY=
# AI_DEFAULT_API_BASE_URL=https://nano-gpt.com/api/v1
# AI_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# AI_DEFAULT_FLASH_MODEL=nvidia/nemotron-3-ultra-550b-a55b

NANO_GPT_API_KEY=
NANO_GPT_API_BASE_URL=https://nano-gpt.com/api/v1
NANO_GPT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NANO_GPT_FLASH_MODEL=nvidia/nemotron-3-ultra-550b-a55b
