# Copy this file to ".env" and fill in values.
# Never commit real secrets to git.

# Managed AI gateway fallback (used only when no direct key is configured).
# Also the memory (Hindsight) proxy — the backend agent runs on the laptop.
# Must be the laptop's tailnet IP for phone builds (localhost = the phone).
EXPO_PUBLIC_AGENT_BASE_URL=http://100.107.7.52:8787

# Direct OpenAI-compatible AI provider (phone-side, the default transport).
# Recommended default: the local OmniRoute gateway (Tailscale-only). Use a
# data-plane key created in the OmniRoute dashboard — never the manage key
# (EXPO_PUBLIC_* values are bundled into device builds).
# Expo bundles EXPO_PUBLIC_* values into local device builds.
EXPO_PUBLIC_NANO_GPT_API_KEY=YOUR_OMNIROUTE_DATA_PLANE_KEY
EXPO_PUBLIC_NANO_GPT_API_BASE_URL=http://100.107.7.52:20128/v1
EXPO_PUBLIC_NANO_GPT_MODEL=cl/dots-studio/dots-3-note-preview:free
EXPO_PUBLIC_NANO_GPT_FLASH_MODEL=cl/dots-studio/dots-3-note-preview:free

# Supabase (Auth, catalog, preferences, and Realtime) — local instance on the
# laptop; use the laptop's tailnet IP for phone builds.
SUPABASE_URL=http://100.107.7.52:54321
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_SUPABASE_URL=http://100.107.7.52:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
