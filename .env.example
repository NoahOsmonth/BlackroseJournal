# Copy this file to ".env" and fill in values.
# Never commit real secrets to git.

# Managed AI gateway (default when the BYOK toggle is off).
# This URL is public; the app sends the signed-in Supabase access token.
EXPO_PUBLIC_AGENT_BASE_URL=http://127.0.0.1:8787

# Direct OpenAI-compatible AI provider (phone-side, BYOK toggle only).
# Recommended BYOK default: OpenRouter free models (ids ending with :free).
# Expo bundles EXPO_PUBLIC_* values into local device builds.
EXPO_PUBLIC_NANO_GPT_API_KEY=YOUR_OPENROUTER_API_KEY
EXPO_PUBLIC_NANO_GPT_API_BASE_URL=https://openrouter.ai/api/v1
EXPO_PUBLIC_NANO_GPT_MODEL=tencent/hy3:free
EXPO_PUBLIC_NANO_GPT_FLASH_MODEL=tencent/hy3:free

# Supabase (Auth, catalog, preferences, and Realtime).
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
