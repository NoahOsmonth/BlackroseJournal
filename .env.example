[TEMPLATE]
# Copy this file to ".env" and fill in values.
# Never commit real secrets to git.

# Direct OpenAI-compatible AI provider (phone-side; the only transport).
#
# These are a FIRST-RUN SEED only. Expo inlines EXPO_PUBLIC_* at build time, so
# they cannot change without a rebuild. After first launch the app reads the
# provider you saved in Settings -> AI Model (base URL, key, model, flash model),
# and you can save several providers there.
#
# Leave these blank to configure everything in-app instead.
#
# EXPO_PUBLIC_* values are bundled into device builds, so never put a key here
# that you would not ship.
EXPO_PUBLIC_AI_CUSTOM_BASE=
EXPO_PUBLIC_AI_CUSTOM_API_KEY=
EXPO_PUBLIC_AI_CUSTOM_MODEL=
EXPO_PUBLIC_AI_CUSTOM_FLASH_MODEL=
